# ==========================================
# Git Ignore Configuration
# Real-Time Multimodal Cricket Commentator
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.*
!.env.example

# Python virtual environments & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node.js & Frontend Build
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Deep Learning Models & Weights (Auto-downloaded by Ultralytics / scripts)
*.pt
*.onnx
*.engine
*.bin
models/*.pt
models/*.onnx
!models/.gitkeep

# Temporary Uploads & Large Media Files
sample_videos/uploads/*
!sample_videos/uploads/.gitkeep
*.log
logs/

# IDE & Editor configurations
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
