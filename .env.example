# ==============================================================================
# Real-Time Multimodal Cricket Commentator - Environment Configuration Example
# Copy this file to .env and configure as needed.
# All fields have sensible defaults; leaving keys blank enables the deterministic local fallback.
# ==============================================================================

# Server Environment
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Generative AI Commentary Engine
# Supported options: gemini, openai, fallback
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI / Compatible API Key (optional alternative)
OPENAI_API_KEY=
LLM_API_BASE=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Text-to-Speech (TTS) Speech Synthesis
# Supported: edge-tts (free, low-latency neural stream), openai, none
# ------------------------------------------------------------------------------
TTS_PROVIDER=edge-tts
TTS_VOICE=en-GB-RyanNeural
TTS_API_KEY=

# ------------------------------------------------------------------------------
# Computer Vision & Hardware Acceleration
# DEVICE options: auto (CUDA if present, otherwise CPU), cuda, cpu
# ------------------------------------------------------------------------------
DEVICE=auto
USE_FP16=false
USE_TENSORRT=false
YOLO_MODEL=yolov8n.pt
YOLO_POSE_MODEL=yolov8n-pose.pt
TARGET_FPS=30
FRAME_WIDTH=640
FRAME_HEIGHT=360

# ------------------------------------------------------------------------------
# Ingestion & Video Source Defaults
# ------------------------------------------------------------------------------
DEFAULT_VIDEO_SOURCE=webcam
WEBCAM_INDEX=0
VIDEO_FILE_PATH=sample_videos/cover_drive_four.mp4
RTSP_URL=

# ------------------------------------------------------------------------------
# Performance & Features
# ------------------------------------------------------------------------------
ENABLE_AUDIO=true
ENABLE_LLM=true
COMMENTARY_STYLE=PROFESSIONAL
REDIS_URL=
DATABASE_URL=
